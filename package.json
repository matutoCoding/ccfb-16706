{
  "name": "aton-optics-sim",
  "version": "1.0.0",
  "private": true,
  "description": "航标灯光学与灯质仿真系统 — TypeScript + WebGL2, IndexedDB 档案",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:eval": "vite --host --port 36706 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "build:strict": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 36706",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "vitest run src/core/__tests__/acceptance.test.ts"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
